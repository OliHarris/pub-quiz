{
  "name": "@pub-quiz/server",
  "version": "0.0.0",
  "private": true,
  "description": "The live game server: rooms, the game loop and WebSocket connections.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --exclude './.data/**' src/index.ts",
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed.ts",
    "bank:generate": "tsx scripts/generate-question-bank.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "@pub-quiz/shared": "*",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "socket.io": "^4.8.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.3.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
